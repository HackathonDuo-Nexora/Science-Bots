PORT=3000
# Comma-separated list of allowed frontend origins (e.g., https://effortless-duckanoo-f35f47.netlify.app,http://localhost:5173)
# Note: Netlify *.netlify.app and local Vite dev ports are also automatically supported.
FRONTEND_URL=http://localhost:5173

# Research mode: 'demo' (deterministic demo data) or 'real' (OpenAlex + Gemini AI Analyzer)
RESEARCH_MODE=demo

# Fallback to demo mode if real search encounters errors or timeouts: 'true' (default) or 'false'
RESEARCH_FALLBACK_TO_DEMO=true

# Google Gemini API key for real AI Analyzer
GEMINI_API_KEY=

# Optional model selection (defaults to gemini-3.1-flash-lite with automatic fallback across flash models)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional configuration for real research provider (OpenAlex works with no API key)
# OPENALEX_API_KEY=
# RESEARCH_CONTACT_EMAIL=research@sciencebots.org
